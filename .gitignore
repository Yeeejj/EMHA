BACKUP/
~$*
.claude/

# ── Raw participant dataset (never commit — read-only, human-subject data) ────
# Includes DATASET/metadata/questionnaire_export.csv, the authoritative
# self-report export (participants' data; never commit).
DATASET/

# ── Pipeline data outputs (never commit image data) ───────────────────────────
DATA/STAGING/
DATA/CROPS/*
DATA/PROCESSED/*
DATA/SPLITS/
!DATA/CROPS/.gitkeep
!DATA/PROCESSED/.gitkeep
FIGURES/*
!FIGURES/.gitkeep

# ── Model checkpoints ─────────────────────────────────────────────────────────
# Trained on real data; too large for git and not source code
models/*.pth
models/*.pkl
models/*.joblib
!models/.gitkeep

# ── Results (regenerated by evaluator / trainer on every run) ─────────────────
results/*
!results/.gitkeep

# ── Secrets ────────────────────────────────────────────────────────────────────
.env*
kaggle.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
env/
.venv/

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
